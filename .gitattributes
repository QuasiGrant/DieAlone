# Default: auto-detect text, normalize to LF in the repo
* text=auto

# Unity YAML files: text, LF endings (.asset left on auto, some are binary)
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Git LFS: images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
